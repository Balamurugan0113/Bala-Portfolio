{
  "name": "ethical-hacker-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "node dist/server/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/render-test.mjs && node scripts/modal-test.mjs",
    "test:render": "node scripts/render-test.mjs",
    "test:modal": "node scripts/modal-test.mjs",
    "icons": "python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.453.0",
    "nodemailer": "^8.0.9",
    "ogl": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.185.0",
    "wouter": "^3.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
